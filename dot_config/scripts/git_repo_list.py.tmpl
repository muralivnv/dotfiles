#!/usr/bin/env -S uv run --script
#
# /// script
# requires-python = ">=3.14"
# dependencies = []
# ///

import subprocess
from pathlib import Path

{{- if or (not .git_repo_list) (eq (len .git_repo_list) 0) -}}
{{ fail "git_repo_list is empty – please set it in your local $HOME/chezmoi/chezmoi.toml" }}
{{- end }}

DEV_FOLDERS = [
    {{- range .git_repo_list }}
        Path({{ printf "%q" . }}),
    {{- end }}
]

REPOS = {d.name: d for d in DEV_FOLDERS}
SCRIPT_DIR = "{{ dir .chezmoi.targetFile }}"

HIDE_PAD = " " * 300

CMD = ["tooey", "--prompt", "[ Repo ] ❯ ",
       "--query-process-command", "gai --no-color -f {{ "{{" }}@QUERY{{ "}}" }}"]

if __name__ == "__main__":
    listing = "".join(f"{k}{HIDE_PAD}\t{v}\n" for k, v in REPOS.items())
    picked = subprocess.run(CMD, input=listing, text=True, capture_output=True)
    if picked.returncode != 0 or not picked.stdout.strip():
        raise SystemExit(picked.returncode if picked.returncode != 130 else 0)

    repo_path = picked.stdout.strip().rsplit("\t", 1)[-1]
    subprocess.run(["uv", "run", f"{SCRIPT_DIR}/git_log.py"],
                   cwd=Path(repo_path).expanduser())
