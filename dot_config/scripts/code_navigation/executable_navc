#!/bin/sh
# Client for the navigation daemon. Sends one tab-delimited line:
#
#     TMUX \t PANE \t CMD \t ARG...
#
# This runs on every bound key, so it stays a handful of execs: no Python (an
# interpreter start here would undo the daemon), and no JSON to escape by hand,
# since the arguments are paths, symbols and integers -- never tabs.

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
TAB=$(printf '\t')

# Must match config.py's derivation exactly, or client and daemon look for the
# socket in two different places: cwd with every non-alphanumeric run collapsed
# to a single dash, then the first 8 hex digits of that directory's MD5.
CACHE_DIR="$HOME/.local/share/ronin/$(printf '%s' "$PWD" | sed 's/[^a-zA-Z0-9]/-/g; s/--*/-/g; s/^-//; s/-$//')"
SOCK="/tmp/nav-$(printf '%s' "$CACHE_DIR" | md5sum | cut -c1-8).sock"
PID_FILE="$CACHE_DIR/nav.pid"

CMD="$1"
shift

MSG="$TMUX$TAB$(tmux display-message -p '#{pane_id}' 2>/dev/null)$TAB$CMD"
for arg in "$@"; do
    MSG="$MSG$TAB$arg"
done

# The daemon acknowledges on receipt, not on completion, so this returns as soon as
# the command has landed -- a picker that runs for a minute does not hold us open.
# No ok means undelivered, which is the one failure a client can do something about.
send() { printf '%s\n' "$MSG" | socat -t1 - UNIX-CONNECT:"$SOCK" 2>/dev/null | grep -q '^ok'; }

start_daemon() {
    rm -f "$SOCK" "$PID_FILE"
    nohup uv run --script "$SCRIPT_DIR/daemon.py" </dev/null >/dev/null 2>&1 &
    i=0
    while [ "$i" -lt 100 ]; do
        [ -S "$SOCK" ] && return 0
        sleep 0.01
        i=$((i + 1))
    done
    return 1
}

# stop is best-effort: tell the daemon, give it a moment, then clear the leftovers.
if [ "$CMD" = "stop" ]; then
    [ -S "$SOCK" ] && send
    sleep 0.2
    rm -f "$SOCK" "$PID_FILE"
    exit 0
fi

if [ -S "$SOCK" ] && send; then
    exit 0
fi
start_daemon && send
